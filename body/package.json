{
  "name": "@emeth/body",
  "version": "0.1.0",
  "description": "EMETH body — the Minecraft embodiment (Mineflayer) of the EMETH autonomous player: perception, reflexes, motor primitives, skill sandbox and the bridge to the mind.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "EMETH_E2E=1 vitest run test/e2e",
    "manifest": "tsx src/tools/print-manifest.ts"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.4",
    "minecraft-data": "^3.119.0",
    "mineflayer": "^4.39.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "pino": "^9.6.0",
    "vec3": "^0.1.10",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "flying-squid": "^1.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
